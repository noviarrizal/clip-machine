{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/crates/oxc_lint/schemas/oxlintrc.schema.json",
  "extends": [],
  "rules": {
    "no-const-assign": "error",
    "no-obj-calls": "error",
    "no-import-assign": "error",
    "no-new-symbol": "error",
    "constructor-super": "error",
    "no-this-before-super": "error",
    "prefer-const": "off"
  }
}
